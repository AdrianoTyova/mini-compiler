{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.seteao",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#comments" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "match": "\\b(VAR|EXIBIR|INTEIRO|REAL|NATURAL|TEXTO|LOGICO|SE|SENAO|VERDADEIRO|FALSO|ENQUANTO|FACA|PARA|INSERIR|RAIZ|EXPOENTE|CONTINUAR|PARAR|E|OU|NAO)\\b",
          "name": "keyword.control.seteao"
        }
      ]
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.seteao"
    },
    "numbers": {
      "match": "\\b[0-9]+\\b",
      "name": "constant.numeric.seteao"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.hash.seteao",
          "match": "#.*$"
        },
        {
          "name": "comment.block.seteao",
          "begin": "##",
          "end": "##"
        }
      ]
    }
  }
}